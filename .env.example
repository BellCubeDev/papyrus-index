# Your Nexus Mods API key - grab it from https://next.nexusmods.com/settings/api-keys
NEXUS_API_KEY = "your-api-key-here"

# A blurb about where this build came from.
# You can leave it exactly how you see it here. In a production build,
# it will be replaced with a link back to the GitHub Action run that
# built that particular version of the site.
NEXT_PUBLIC_BUILD_SOURCE_MD = "This is a **DEVELOPMENT BUILD** and may not be suitable for wider publishing. Upon publication, this text will be replaced with information pointing back to the deployed version's CI build."

# If you're getting spammed with diagnostic logs about things like the data
# in Papyrus scripts or the Wikis, you can disable that high-level
# diagnostic logging here
SKIP_HIGH_LEVEL_DIAGNOSTIC_LOGS = 'false'

# Configuration for Posthog analytics
# These values are provided by Posthog; they allow our code to send anonymous
# analytic information to better understand how users use the Papyrus Index.
NEXT_PUBLIC_POSTHOG_KEY='phc_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXx'
NEXT_PUBLIC_POSTHOG_HOST='https://us.example.com'
