{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach: Chromium Browser",
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Run: Next.js Dev Server",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
        },
        {
            "name": "Run: Typecheck",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "run",
                "typecheck"
            ],
        },
        {
            "name": "Run: Index All Papyrus Scripts",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "run",
                "parse:and-index"
            ],
        }
    ]
}
