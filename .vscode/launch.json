{
    "version": "0.2.0",
    "configurations": [
		{
			"name": "Papyrus Grammar Test Extension",
			"type": "extensionHost",
			"request": "launch",
            "cwd": "${workspaceFolder}/vscode-language-dev-ext",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/vscode-language-dev-ext",
                "${workspaceFolder}/vscode-language-dev-ext/testing.psc"
			]
		},
        {
            "name": "Attach: Chromium Browser",
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Run: Next.js Dev Server",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
        },
        {
            "name": "Run: Typecheck",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "run",
                "typecheck"
            ],
        },
        {
            "name": "Run: Index All Papyrus Scripts",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "run",
                "parse:and-index"
            ],
        }
    ]
}
