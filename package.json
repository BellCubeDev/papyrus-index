{
  "name": "papyrus-index",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "dev": "$env:FORCE_COLOR = 'true'; pnpm run parse:reset; next dev --turbo",
    "start": "npx serve out",
    "lint": "next lint",
    "prepare": "husky; pnpm run '/^prepare:/'",
    "prepare:parsoid-service": "cd ./node_modules/parsoid-service; composer install",
    "prepare:wiki-repo:this": "If (-not (Test-Path -Path './cache/github-wikis/this/')) { git clone https://github.com/BellCubeDev/papyrus-index.wiki.git ./cache/github-wikis/this/ } else {cd ./cache/github-wikis/this/ && git reset --hard && git pull }",
    "prepare:wiki-repo:skyrim:po3": "If (-not (Test-Path -Path './cache/github-wikis/SkyrimSE/po3/')) { git clone https://github.com/powerof3/PapyrusExtenderSSE.wiki.git ./cache/github-wikis/SkyrimSE/po3/ } else { cd ./cache/github-wikis/SkyrimSE/po3/ && git reset --hard && git pull }",
    "prepare:schemas": "typescript-json-schema './src/papyrus/data-structures/pure/scriptSource.ts' PapyrusScriptSourceMetadataForSchema --required --noExtraProps --strictNullChecks --skipLibCheck -o './data/SourceMetadata.schema.json' --include './src/papyrus/data-structures/pure/**'; typescript-json-schema './src/papyrus/data-structures/ignore-yaml.ts' IgnoreYaml --required --noExtraProps --strictNullChecks --skipLibCheck -o './data/IgnoreYaml.schema.json' --include './src/papyrus/data-structures/ignore-yaml.ts'",
    "download-mods": "tsx  --env-file-if-exists=./.env ./src/papyrus/scraping/download/DownloadNeededMods.ts",
    "parse:reset": "rm -f ./public/raw.json",
    "parse:raw": "tsx ./src/papyrus/parsing/parse-or-load-all.ts",
    "parse": "pnpm run parse:reset; pnpm run parse:raw",
    "guard-papyrus-logic": "$env:DO_GUARD_LOGIC='true'\npnpm run parse",
    "parse:and-index": "pnpm run parse; tsx ./src/papyrus/indexing/index-all.ts",
    "build": "$env:FORCE_COLOR = 'true'; tsx buildWithStepSummary.ts",
    "typecheck": "$env:FORCE_COLOR = 'true'; tsx ./typecheck.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "7zip-min": "^1.4.5",
    "@bprogress/next": "^3.2.12",
    "@eslint/compat": "^1.2.8",
    "@eslint/js": "^9.25.0",
    "@floating-ui/react": "^0.27.7",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@headlessui/react": "^2.2.2",
    "@next/eslint-plugin-next": "^15.3.1",
    "@nexusmods/nexus-api": "github:Nexus-Mods/node-nexus-api",
    "@nimpl/classnames-minifier": "^4.0.0",
    "@types/7zip-min": "^1.3.3",
    "@types/hast": "^3.0.4",
    "@types/jsdom": "^21.1.7",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.14.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/unzip-stream": "^0.3.4",
    "@vercel/og": "^0.6.8",
    "@wcj/html-to-markdown": "^2.1.1",
    "@wooorm/starry-night": "^3.7.0",
    "ajv": "^8.17.1",
    "babel-plugin-react-compiler": "19.0.0-beta-63e3235-20250105",
    "client-only": "^0.0.1",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.3.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.0.0-beta-55955c9-20241229",
    "eslint-plugin-react-hooks": "^5.2.0",
    "execa": "^9.5.2",
    "fuzzysort": "^3.1.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "next": "^15.3.1",
    "node-fetch": "^3.3.2",
    "octokit": "^4.1.3",
    "papyrus-index-typescript-plugin": "file:typescript-plugin",
    "parsoid-service": "file:./cache/parsoid-service",
    "posthog-js": "^1.236.3",
    "proper-lockfile": "^4.1.2",
    "react": "~19.0.0",
    "react-dom": "~19.0.0",
    "react-fontawesome": "^1.7.1",
    "react-markdown": "^9.1.0",
    "remark": "^15.0.1",
    "remark-breaks": "^4.0.0",
    "remove-markdown": "^0.6.0",
    "sass": "^1.86.3",
    "scheduler-polyfill": "^1.3.0",
    "server-only": "^0.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "typescript-json-schema": "^0.65.1",
    "unplugin-auto-import": "^0.19.0",
    "unzip-stream": "^0.3.4",
    "vitest": "^2.1.9",
    "yaml": "^2.7.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "fuzzysort": "patches/fuzzysort.patch",
      "typescript": "patches/typescript.patch",
      "scheduler-polyfill": "patches/scheduler-polyfill.patch"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "papyrus-index-typescript-plugin"
    ],
    "overrides": {
      "@types/node": "^22.14.1"
    }
  },
  "devDependencies": {
    "serve": "^14.2.4"
  }
}
