{
  "name": "papyrus-index",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215",
  "scripts": {
    "dev": "$env:FORCE_COLOR = 'true'; pnpm run parse:reset; next dev --turbo",
    "start": "npx serve out",
    "lint": "eslint .",
    "prepare": "husky; pnpm run '/^prepare:/'",
    "prepare:next-typegen": "next typegen",
    "prepare:parsoid-service": "cd ./node_modules/parsoid-service; composer install",
    "prepare:wiki-repo:this": "If (-not (Test-Path -Path './cache/github-wikis/this/')) { git clone https://github.com/BellCubeDev/papyrus-index.wiki.git ./cache/github-wikis/this/ } else {cd ./cache/github-wikis/this/ && git reset --hard && git pull }",
    "prepare:wiki-repo:skyrim:po3": "If (-not (Test-Path -Path './cache/github-wikis/SkyrimSE/po3/')) { git clone https://github.com/powerof3/PapyrusExtenderSSE.wiki.git ./cache/github-wikis/SkyrimSE/po3/ } else { cd ./cache/github-wikis/SkyrimSE/po3/ && git reset --hard && git pull }",
    "prepare:wiki-repo:skyrim:skyui-sdk": "If (-not (Test-Path -Path './cache/github-wikis/SkyrimSE/skyui-sdk/')) { git clone https://github.com/schlangster/skyui.wiki.git ./cache/github-wikis/SkyrimSE/skyui-sdk/ } else { cd ./cache/github-wikis/SkyrimSE/skyui-sdk/ && git reset --hard && git pull }",
    "prepare:schemas": "ts-json-schema-generator --tsconfig './tsconfig.json' --path  './src/papyrus/data-structures/pure/scriptSource.ts' --type PapyrusScriptSourceMetadataForSchemaPapyrusGame -o './data/SourceMetadata.schema.json' --no-type-check && ts-json-schema-generator --tsconfig './tsconfig.json' --path './src/papyrus/data-structures/ignore-yaml.ts' --type IgnoreYaml -o './data/IgnoreYaml.schema.json' --no-type-check",
    "download-mods": "tsx  --env-file-if-exists=./.env ./src/papyrus/scraping/download/DownloadNeededMods.ts",
    "parse:reset": "rm -f ./public/raw.json",
    "parse:raw": "tsx ./src/papyrus/parsing/parse-or-load-all.ts",
    "parse": "pnpm run parse:reset; pnpm run parse:raw",
    "guard-papyrus-logic": "$env:DO_GUARD_LOGIC='true'\npnpm run parse",
    "parse:and-index": "pnpm run parse; tsx ./src/papyrus/indexing/index-all.ts",
    "build": "$env:FORCE_COLOR = 'true'; tsx buildWithStepSummary.ts",
    "postbuild": "next-sitemap",
    "typecheck": "$env:FORCE_COLOR = 'true'; tsx ./typecheck.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "7zip-min": "^2.1.0",
    "@bprogress/next": "^3.2.12",
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.2",
    "@floating-ui/react": "^0.27.16",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@headlessui/react": "^2.2.9",
    "@next/eslint-plugin-next": "^16.1.1",
    "@nexusmods/nexus-api": "github:Nexus-Mods/node-nexus-api",
    "@nimpl/classnames-minifier": "^4.0.1",
    "@shikijs/colorized-brackets": "^3.20.0",
    "@shikijs/themes": "^3.20.0",
    "@shikijs/transformers": "^3.20.0",
    "@types/hast": "^3.0.4",
    "@types/jsdom": "^27.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.0.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/unzip-stream": "^0.3.4",
    "@vercel/og": "^0.8.6",
    "@wcj/html-to-markdown": "^2.1.1",
    "@wooorm/starry-night": "^3.8.0",
    "ajv": "^8.17.1",
    "babel-plugin-react-compiler": "19.1.0-rc.3",
    "client-only": "^0.0.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-no-manual-memo": "^1.0.4",
    "execa": "^9.6.1",
    "fuzzysort": "^3.1.0",
    "globals": "^16.5.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "json-schema-to-typescript": "^15.0.4",
    "next": "^16.1.1",
    "next-sitemap": "^4.2.3",
    "node-fetch": "^3.3.2",
    "octokit": "^5.0.5",
    "papyrus-index-typescript-plugin": "file:typescript-plugin",
    "parsoid-service": "file:./parsoid-service",
    "posthog-js": "^1.310.1",
    "proper-lockfile": "^4.1.2",
    "react": "~19.2.3",
    "react-dom": "~19.2.3",
    "react-fontawesome": "^1.7.1",
    "react-geiger": "^1.2.2",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark": "^15.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.97.1",
    "scheduler-polyfill": "^1.3.0",
    "schema-dts": "^1.1.5",
    "server-only": "^0.0.1",
    "shiki": "^3.20.0",
    "strip-markdown": "^6.0.0",
    "ts-json-schema-generator": "^2.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "unist-util-visit": "^5.0.0",
    "unplugin-auto-import": "^20.3.0",
    "unzip-stream": "^0.3.4",
    "vitest": "^4.0.16",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "serve": "^14.2.5"
  },
  "peerDependencies": {
    "vscode-oniguruma": "*"
  }
}
